<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.platform.mapper.SchoolMapper">

    <resultMap id="SchoolResultMap" type="com.edu.platform.domain.School">
        <id property="schoolId" column="school_id"/>
        <result property="schoolName" column="school_name"/>
        <result property="schoolCode" column="school_code"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="logoUrl" column="logo_url"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="SchoolResultMap">
        SELECT * FROM schools WHERE school_id = #{schoolId}
    </select>

    <select id="findByCode" resultMap="SchoolResultMap">
        SELECT * FROM schools WHERE school_code = #{schoolCode} AND is_active = 1
    </select>

    <select id="findAll" resultMap="SchoolResultMap">
        SELECT * FROM schools ORDER BY school_name
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM schools
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="schoolId">
        INSERT INTO schools (school_name, school_code, address, phone, is_active, created_at, updated_at)
        VALUES (#{schoolName}, #{schoolCode}, #{address}, #{phone}, 1, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE schools SET
            school_name = #{schoolName},
            address = #{address},
            phone = #{phone},
            logo_url = #{logoUrl},
            is_active = #{isActive},
            updated_at = NOW()
        WHERE school_id = #{schoolId}
    </update>

</mapper>
