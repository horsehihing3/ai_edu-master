<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.platform.mapper.PasswordResetTokenMapper">

    <resultMap id="TokenResultMap" type="com.edu.platform.domain.PasswordResetToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="token" column="token"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="used" column="used"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO password_reset_tokens (user_id, token, expires_at, used, created_at)
        VALUES (#{userId}, #{token}, #{expiresAt}, #{used}, NOW())
    </insert>

    <select id="findByToken" resultMap="TokenResultMap">
        SELECT * FROM password_reset_tokens WHERE token = #{token}
    </select>

    <update id="markUsed">
        UPDATE password_reset_tokens SET used = 1 WHERE token = #{token}
    </update>

    <delete id="deleteExpiredByUserId">
        DELETE FROM password_reset_tokens
        WHERE user_id = #{userId} AND (expires_at &lt; NOW() OR used = 1)
    </delete>

</mapper>
