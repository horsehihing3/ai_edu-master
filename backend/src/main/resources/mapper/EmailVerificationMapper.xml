<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.platform.mapper.EmailVerificationMapper">

    <resultMap id="VerificationResultMap" type="com.edu.platform.domain.EmailVerification">
        <id property="verificationId" column="verification_id"/>
        <result property="userId" column="user_id"/>
        <result property="email" column="email"/>
        <result property="token" column="token"/>
        <result property="purpose" column="purpose"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="usedAt" column="used_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="verificationId">
        INSERT INTO email_verifications (user_id, email, token, purpose, expires_at, created_at)
        VALUES (#{userId}, #{email}, #{token}, #{purpose}, #{expiresAt}, NOW())
    </insert>

    <select id="findByToken" resultMap="VerificationResultMap">
        SELECT * FROM email_verifications WHERE token = #{token}
    </select>

    <update id="markUsed">
        UPDATE email_verifications SET used_at = NOW() WHERE token = #{token}
    </update>

    <delete id="deleteUnusedByEmail">
        DELETE FROM email_verifications
        WHERE email = #{email} AND used_at IS NULL
    </delete>

</mapper>
